						"admin-services",
						"users",
						"{{adminUser}}",
						"servers",
						"{{atlasEgeriaServer}}",
						"cohorts",
						"{{cohort}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Configure Atlas connection",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"class\": \"Connection\",\n    \"connectorType\": {\n        \"class\": \"ConnectorType\",\n        \"connectorProviderClassName\": \"org.odpi.egeria.connectors.apache.atlas.repositoryconnector.ApacheAtlasOMRSRepositoryConnectorProvider\"\n    },\n    \"endpoint\": {\n        \"class\": \"Endpoint\",\n        \"address\": \"{{atlasURL}}\",\n        \"protocol\": \"{{atlasProtocol}}\"\n    },\n    \"userId\": \"{{atlasUser}}\",\n    \"clearPassword\": \"{{atlasPassword}}\"\n}"
				},
				"url": {
					"raw": "{{baseURL}}/open-metadata/admin-services/users/{{adminUser}}/servers/{{atlasEgeriaServer}}/local-repository/mode/repository-proxy/connection",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"open-metadata",
						"admin-services",
						"users",
						"{{adminUser}}",
						"servers",
						"{{atlasEgeriaServer}}",
						"local-repository",
						"mode",
						"repository-proxy",
						"connection"
					]
				}
			},
			"response": []
		},
		{
			"name": "Configure Atlas Event Mapper",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseURL}}/open-metadata/admin-services/users/{{adminUser}}/servers/{{atlasEgeriaServer}}/local-repository/event-mapper-details?connectorProvider=org.odpi.egeria.connectors.apache.atlas.eventmapper.ApacheAtlasOMRSRepositoryEventMapperProvider&eventSource={{atlasKafkaBrokers}}",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"open-metadata",
						"admin-services",
						"users",
						"{{adminUser}}",
						"servers",
						"{{atlasEgeriaServer}}",
						"local-repository",
						"event-mapper-details"
					],
					"query": [
						{
							"key": "connectorProvider",
							"value": "org.odpi.egeria.connectors.apache.atlas.eventmapper.ApacheAtlasOMRSRepositoryEventMapperProvider"
						},
						{
							"key": "eventSource",
							"value": "{{atlasKafkaBrokers}}"
						}
					]
				}
			},
			"response": []
		},
