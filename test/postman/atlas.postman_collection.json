	"item": [
		{
			"name": "Configure Event Bus for Atlas server",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"producer\":{\"bootstrap.servers\":\"{{kafkaBrokers}}\"},\"consumer\":{\"bootstrap.servers\":\"{{kafkaBrokers}}\"}}"
				},
				"url": {
					"raw": "{{baseURL}}/open-metadata/admin-services/users/{{adminUser}}/servers/{{atlasEgeriaServer}}/event-bus?connectorProvider=org.odpi.openmetadata.adapters.eventbus.topic.kafka.KafkaOpenMetadataTopicProvider&topicURLRoot={{topicRoot}}",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"open-metadata",
						"admin-services",
						"users",
						"{{adminUser}}",
						"servers",
						"{{atlasEgeriaServer}}",
						"event-bus"
					],
					"query": [
						{
							"key": "connectorProvider",
							"value": "org.odpi.openmetadata.adapters.eventbus.topic.kafka.KafkaOpenMetadataTopicProvider"
						},
						{
							"key": "topicURLRoot",
							"value": "{{topicRoot}}"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Configure cohort membership",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseURL}}/open-metadata/admin-services/users/{{adminUser}}/servers/{{atlasEgeriaServer}}/cohorts/{{cohort}}",
					"host": [
						"{{baseURL}}"
					],
					"path": [
